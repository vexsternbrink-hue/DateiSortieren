# Kopieren nach ~/.dateisortieren/.env – wird vom Agenten automatisch geladen.
# Nur den Key des gewählten Providers (ai.provider in config.yaml) eintragen.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional statt config.yaml:
# DATEISORTIEREN_API_URL=https://dein-projekt.vercel.app
# DATEISORTIEREN_AGENT_TOKEN=ds_...
